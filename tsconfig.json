{
    "compilerOptions": {
        "target": "ES6",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "useDefineForClassFields": true,
        "checkJs": true,
        "allowJs": true,
        "jsx": "react-jsx",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node", "vite/client", "vite-plugin-pwa/client"],
        "outDir": "dist"
    },
    "include": ["src/**/*", "*.ts", "*.mts"]
}
